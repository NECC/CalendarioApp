# Copia para .env.local e para as variáveis de ambiente do projeto na Vercel.

# Chaves VAPID para Web Push. Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto real para os serviços de push (mailto: ou https:)
VAPID_SUBJECT=

# Segredo do cron (/api/cron/notify). Gerar com: openssl rand -hex 32
CRON_SECRET=

# Upstash Redis: criados ao ligar o Upstash pelo Marketplace da Vercel.
# Em local podes deixar vazio: as subscrições ficam em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=
