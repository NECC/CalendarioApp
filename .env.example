# Copy to .env.local and to the project's environment variables on Vercel.

# VAPID keys for Web Push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Real contact for the push services (mailto: or https:)
VAPID_SUBJECT=

# Secret for the cron (/api/cron/notify). Generate with: openssl rand -hex 32
CRON_SECRET=

# Upstash Redis: created when Upstash is connected through the Vercel Marketplace.
# Can be left empty locally: subscriptions are then kept in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
