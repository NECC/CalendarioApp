# Copia para .env.local (local) e para Vercel → Settings → Environment Variables (produção).

# Chaves VAPID para Web Push. Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para os push services (mailto: ou https:)
VAPID_SUBJECT=mailto:o-teu-email@example.com

# Segredo do cron (/api/cron/notify). Gerar com: openssl rand -hex 32
CRON_SECRET=

# Upstash Redis — criados automaticamente ao ligar o Upstash pelo Marketplace da Vercel.
# Em local podes deixar vazio: as subscrições ficam em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=
